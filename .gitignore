# Python environments: only venv/ is used (core/env.py stops any other Python); never in git
venv/
cenv/
.venv/

.agents/
.claude/

# Python leftovers (__pycache__/ and data/ are kept in git on purpose)
.pytest_cache/

# Secrets: the mail account for 08_notify. Only secrets.example.env (no passwords) belongs in git.
secrets.env
*.env
!secrets.example.env

# macOS and editors
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# Fine-tuned model weights (~190 MB each, over GitHub's 100 MB file limit). index.csv stays in git;
# python main.py 3 --only chronos_finetune makes the weights again.
data/checkpoints/chronos_finetune/*/

# a run in progress (core/runs.py) and half-written files
data/runs/running.json
data/runs/live.log
*.tmp
